{
 "label": "Clean native",
 "summary": "Near-white ground, a neutral sans headline with one word in the brand colour, the biggest possible UI. Lets a polished interface speak - the default for tools and AI apps.",
 "references": [
  "ChatGPT",
  "Google Gemini",
  "Waze",
  "Flo",
  "Structured",
  "Pixelcut"
 ],
 "fits": [
  "productivity",
  "utilities",
  "business",
  "developer-tools",
  "health-fitness",
  "medical",
  "education",
  "navigation"
 ],
 "personality": [
  "clear",
  "competent",
  "modern",
  "quiet"
 ],
 "avoid": "Apps whose UI is plain or busy - it hides nothing.",
 "style": {
  "background": {
   "gradient": [
    "#F7F7F9",
    "$primary_tint"
   ]
  },
  "text_color": "$ink",
  "sub_color": "$ink_soft",
  "font": "sans",
  "tracking": -0.024,
  "headline_size": 0.094,
  "min_headline_size": 0.064,
  "line_height": 1.04,
  "max_lines": 2,
  "align": "center",
  "caption_top": 0.105,
  "emphasis": {
