   "color": "$primary"
  },
  "overline_style": {
   "font": "sans-medium",
   "size": 0.034,
   "color": "$primary",
   "tracking": 0.02,
   "case": "none",
   "gap": 0.026
  },
  "device": {
   "style": "phone",
   "width": 0.84,
   "border_color": "#111114",
   "gap": 0.07,
   "shadow": true
  },
  "poster_size": 0.19
 },
 "poster_defaults": {
  "background": {
   "color": "$primary"
  },
  "text_color": "#FFFFFF",
  "emphasis": {
   "color": "$ink"
  }
 }
}